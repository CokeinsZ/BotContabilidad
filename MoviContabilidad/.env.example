# URL del bot (API /app). Se lee al empaquetar: reinicia `npx expo start` al cambiarla.
# - Servidor: https://contabilidad.notiasis.com
# - Bot local (docker-compose.local.yml): http://10.0.2.2:8000 desde el emulador de Android,
#   http://localhost:8000 desde el simulador de iOS. El compose local solo escucha en
#   127.0.0.1, así que un teléfono físico no llega a él: usa el servidor.
EXPO_PUBLIC_API_URL=https://contabilidad.notiasis.com
