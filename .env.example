EVOLUTION_API_BASE_URL=#Url a la instancia de Evolution API para mensajes de WhatsApp
EVOLUTION_API_INSTANCE_NAME=#Nombre de la instancia de Evolution API
EVOLUTION_API_TOKEN=#Token de la instancia de Evolution API

WHISPER_URL=#Url a la instancia de Whisper para transcripción de audio

DEEPSEEK_API_URL=#Url a la instancia de DeepSeek para generación de texto
DEEPSEEK_API_KEY=#Token de la instancia de DeepSeek

# IDs universales (iguales para todos los businesses)
MASTER_FOLDER_ID=#ID de la carpeta principal
PLANILLA_TEMPLATE_ID=#ID de la plantilla de planilla que se duplica

# Google OAuth (el redirect URI debe estar autorizado en Google Cloud Console)
GOOGLE_OAUTH_REDIRECT_URI=https://contabilidad.notiasis.com/auth/callback
# Rutas dentro del contenedor: /app/secrets/... (el compose monta /home/debian/secrets -> /app/secrets)
# Para correr local sin docker: dejar vacías y se usan ./client_secret.json y ./token.json
GOOGLE_CLIENT_SECRET_PATH=
GOOGLE_TOKEN_PATH=

# Base de datos SQLite
# Ruta dentro del contenedor: /app/secrets/data/bot_contabilidad.db
# Para correr local sin docker: dejar vacías y se usan ./data/bot_contabilidad.db y ./db.sql
DATABASE_PATH=
DATABASE_SCHEMA_PATH=
