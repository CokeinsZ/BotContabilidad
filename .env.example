EVOLUTION_API_BASE_URL=#Url a la instancia de Evolution API para mensajes de WhatsApp
EVOLUTION_API_INSTANCE_NAME=#Nombre de la instancia de Evolution API
EVOLUTION_API_TOKEN=#Token de la instancia de Evolution API

WHISPER_URL=#Url a la instancia de Whisper para transcripción de audio

DEEPSEEK_API_URL=#Url a la instancia de DeepSeek para generación de texto
DEEPSEEK_API_KEY=#Token de la instancia de DeepSeek

# IDs universales (iguales para todos los businesses)
PLANILLA_TEMPLATE_ID=#ID de la plantilla de planilla diaria que se duplica (Formato_Planilla)
WORKERS_TEMPLATE_ID=#ID de la plantilla de trabajador que se duplica para cada trabajador nuevo (Formato_Trabajadores)

# Google OAuth (el redirect URI debe estar autorizado en Google Cloud Console)
GOOGLE_OAUTH_REDIRECT_URI=https://contabilidad.notiasis.com/auth/callback
# Cuentas de Google con las que se permite autenticar el servidor (separadas por coma).
# Vacío = cualquier cuenta (no recomendado).
GOOGLE_ALLOWED_EMAILS=
# Rutas dentro del contenedor: /app/secrets/... (el compose monta /home/debian/secrets -> /app/secrets)
# Para correr local sin docker: dejar vacías y se usan ./client_secret.json y ./token.json
GOOGLE_CLIENT_SECRET_PATH=
GOOGLE_TOKEN_PATH=

# Protección de /auth/login, /auth/status y /auth/refresh-token (HTTP Basic).
# Sin contraseña, /auth/login queda deshabilitado. Usa una contraseña larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=

# Base de datos SQLite
# Ruta dentro del contenedor: /app/secrets/data/bot_contabilidad.db
# Para correr local sin docker: dejar vacías y se usan ./data/bot_contabilidad.db y ./db.sql
DATABASE_PATH=
DATABASE_SCHEMA_PATH=

# Zona horaria del negocio: define qué es "hoy" (el contenedor corre en UTC)
TIMEZONE=America/Bogota

# API de la app móvil (/app). Sin APP_JWT_SECRET queda deshabilitada (503).
# Secreto largo y aleatorio para firmar los tokens de la app:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarlo cierra la sesión de todas las apps (tendrán que vincularse de nuevo).
APP_JWT_SECRET=
APP_ACCESS_TOKEN_MINUTES=60
APP_REFRESH_TOKEN_DAYS=90
# Número de WhatsApp del bot con indicativo, solo dígitos (ej: 573001234567).
# La app abre wa.me/<número> para que el administrador envíe "VINCULAR <código>".
BOT_WHATSAPP_NUMBER=
# Códigos de vinculación que puede pedir una misma IP cada 10 minutos (por defecto 10).
APP_PAIRINGS_PER_IP=
# Dónde está publicada la versión web de la app (separados por comas), para CORS.
# Ej: https://movil.notiasis.com (el dominio que el proxy apunta a movicontabilidad-web)
APP_WEB_ORIGINS=
# URL del bot que usa la versión web (servicio movicontabilidad-web del compose).
# Se fija al construir la imagen; por defecto https://contabilidad.notiasis.com.
APP_WEB_API_URL=

# Pruebas E2E (uv run pytest --e2e): carpeta de Drive donde cada corrida crea
# su propia subcarpeta temporal (se manda a la papelera al terminar).
E2E_DRIVE_FOLDER_ID=
